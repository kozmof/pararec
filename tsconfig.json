{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  },
  "include": [
    "client/src/**/*.ts",
    "client/src/**/*.js",
    "client/src/**/*.svelte",
    "vite.config.ts",
    "svelte.config.js",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts"
  ]
}
