{
  "name": "workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(client|css|api)$/\"",
    "dev:client": "vite",
    "dev:css": "panda --watch",
    "dev:api": "cd server && STATIC_DIR=client/public zig build run",
    "dev:server": "cd server && zig build run",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "panda && vite build",
    "build:server": "cd server && zig build -Doptimize=ReleaseSafe",
    "start": "./server/zig-out/bin/server",
    "preview": "pnpm build:client && cd server && zig build run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:server": "cd server && zig build test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "panda codegen"
  },
  "devDependencies": {
    "@pandacss/dev": "2.0.0",
    "@pandacss/preset-base": "2.0.0",
    "@pandacss/preset-panda": "2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.17.1"
}
