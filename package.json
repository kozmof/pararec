{
  "name": "workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(client|css|api)$/\"",
    "dev:client": "vite",
    "dev:css": "panda --watch",
    "dev:api": "cd local && zig build run -- serve ../document.json --static ../client/public",
    "build": "pnpm build:client && pnpm build:local",
    "build:client": "panda && vite build",
    "start": "./local/zig-out/bin/pararec serve document.json",
    "preview": "pnpm build && pnpm start",
    "check": "svelte-check --workspace client --tsconfig ../tsconfig.json --config ../svelte.config.js",
    "check:watch": "svelte-check --workspace client --tsconfig ../tsconfig.json --config ../svelte.config.js --watch",
    "test": "TMPDIR=/tmp vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "panda codegen",
    "dev:local": "cd local && zig build run -- serve ../document.json --static ../client/public",
    "build:local": "cd local && zig build -Doptimize=ReleaseSafe",
    "test:local": "cd local && zig build test",
    "test:api": "pnpm build:local && node --test tests/api.test.mjs",
    "test:e2e": "TMPDIR=/tmp playwright test",
    "test:unit": "TMPDIR=/tmp vitest run"
  },
  "dependencies": {
    "@kozmof/reed": "^4.0.1"
  },
  "devDependencies": {
    "@pandacss/dev": "2.0.0",
    "@pandacss/preset-base": "2.0.0",
    "@pandacss/preset-panda": "2.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.17.1"
}
